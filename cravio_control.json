class MainGateway extends StatelessWidget {
  const MainGateway({super.key});

  @override
  Widget build(BuildContext context) {
    final state = AppState.instance;

    if (state.currentRole == 'Restaurant') return const RestaurantPartnerDashboard();
    if (state.currentRole == 'Admin') return const EevaanSuperAdminDashboard();

    return const CustomerTabsView();
  }
}

