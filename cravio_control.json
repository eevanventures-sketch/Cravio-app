void main() {
  runApp(const CravioApp());
}

// ---------------- APP STATE & DYNAMIC REMOTE ENGINE ----------------
class AppState extends ChangeNotifier {
  static final AppState instance = AppState();

  bool isHindi = true;
  bool isLoggedIn = false;
  String currentRole = 'Customer'; // 'Customer', 'Restaurant', 'Admin'
  String selectedRestaurant = "Hotel Marwari";

  // Customer Profile
  String userName = "राहुल शर्मा";
  String userPhone = "9826012345";
  String userArea = "नेहरू चौक";
  String userHouse = "मकान नं. 42, गली नं. 2";
  String userLandmark = "पुरानी गल्ला मंडी के पास, गंजबासौदा";

  String get fullAddress => "$userHouse, $userArea ($userLandmark)";

  // Dynamic Remote Data Loaded from GitHub Backend File
  Map<String, dynamic> remoteConfig = {};
  bool isLoadingRemote = false;

  Map<String, int> cart = {};
  String activeRestaurant = "";
  List<Map<String, dynamic>> orders = [];

  // Live Auto-Sync Function (Fetches from cravio_control.json)
  Future<void> syncRemoteData() async {
    isLoadingRemote = true;
    notifyListeners();

    try {
      final client = HttpClient();
      // Cache-busting URL with timestamp
      final uri = Uri.parse(
        'https://raw.githubusercontent.com/eevanventures-sketch/Cravio-app/main/cravio_control.json?t=${DateTime.now().millisecondsSinceEpoch}',
      );
      final request = await client.getUrl(uri);
      final response = await request.close();

      if (response.statusCode == 200) {
        final responseBody = await response.transform(utf8.decoder).join();
        remoteConfig = jsonDecode(responseBody) as Map<String, dynamic>;
      }
    } catch (e) {
      // Fallback silently if offline
    } finally {
      isLoadingRemote = false;
      notifyListeners();
    }
  }

  void toggleLang(bool hindi) {
    isHindi = hindi;
    notifyListeners();
  }

  void login({required String phone, required String role, String res = "Hotel Marwari"}) {
    userPhone = phone;
    currentRole = role;
    selectedRestaurant = res;
    isLoggedIn = true;
    notifyListeners();
  }

  void logout() {
    isLoggedIn = false;
    cart.clear();
    notifyListeners();
  }

  void updateProfile({
    required String name,
    required String phone,
    required String area,
    required String house,
    required String landmark,
  }) {
    userName = name;
    userPhone = phone;
    userArea = area;
    userHouse = house;
    userLandmark = landmark;
    notifyListeners();
  }

  void addToCart(String item, String res) {
    if (activeRestaurant.isNotEmpty && activeRestaurant != res) {
      cart.clear();
    }
    activeRestaurant = res;
    cart[item] = (cart[item] ?? 0) + 1;
    notifyListeners();
  }

  void removeFromCart(String item) {
    if (cart.containsKey(item)) {
      if (cart[item]! > 1) {
        cart[item] = cart[item]! - 1;
      } else {
        cart.remove(item);
        if (cart.isEmpty) activeRestaurant = "";
      }
      notifyListeners();
    }
  }

  void placeOrder(List<Map<String, dynamic>> items, int total, String paymentMethod) {
    orders.insert(0, {
      "id": "CRV-${DateTime.now().millisecondsSinceEpoch % 10000}",
      "customerName": userName,
      "customerPhone": userPhone,
      "address": fullAddress,
      "res": activeRestaurant,
      "items": List.from(items),
      "total": total,
      "payment": paymentMethod,
      "status": isHindi ? "स्वीकृत (Confirmed)" : "Confirmed",
      "time": "Just now",
    });
    cart.clear();
    activeRestaurant = "";
    notifyListeners();
  }

  void updateOrderStatus(String orderId, String newStatus) {
    final idx = orders.indexWhere((o) => o["id"] == orderId);
    if (idx != -1) {
      orders[idx]["status"] = newStatus;
      notifyListeners();
    }
  }
}

// ---------------- APP ROOT ----------------
class CravioApp extends StatefulWidget {
  const CravioApp({super.key});

  @override
  State<CravioApp> createState() => _CravioAppState();
}

class _CravioAppState extends State<CravioApp> {
  @override
  void initState() {
    super.initState();
    // Auto-Sync from GitHub on App Start
    AppState.instance.syncRemoteData();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: AppState.instance,
      builder: (context, _) {
        return MaterialApp(
          title: 'Cravio - Ganj Basoda',
          debugShowCheckedModeBanner: false,
          theme: ThemeData(
            scaffoldBackgroundColor: const Color(0xFFF9F8F6),
            primaryColor: const Color(0xFF262220),
            colorScheme: ColorScheme.fromSeed(
              seedColor: const Color(0xFF262220),
              primary: const Color(0xFF262220),
              secondary: const Color(0xFFC5A059),
            ),
            fontFamily: 'Roboto',
          ),
          home: AppState.instance.isLoggedIn ? const MainGateway() : const LoginAuthScreen(),
        );
      },
    );
  }
}

